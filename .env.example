# Server-side key for the "Ask AI" and GEPF statement extraction endpoints (server/index.ts).
# Never commit a real key. Alternatively, users can paste their own key in the app's AI settings
# (stored only in their browser's localStorage) and the app will call the Anthropic API directly.
ANTHROPIC_API_KEY=
# Optional: model override for the AI assistant (default claude-opus-5)
AI_MODEL=claude-opus-5
PORT=8787
