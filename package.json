{
  "name": "sa-pension-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm run server\"",
    "web": "vite",
    "server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build:single": "tsc -b && vite build --config vite.config.single.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  },
  "description": "South African pension planner: GEPF stay-vs-leave, tax, fund fees, rand hedging, scenario planner and AI assistant"
}
